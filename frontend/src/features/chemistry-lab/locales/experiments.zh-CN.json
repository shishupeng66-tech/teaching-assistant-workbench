          ["metallic", "metallicLabel"]
        ],
        "kind": "select"
      },
      {
        "key": "step",
        "label": "step",
        "default": 1,
        "min": 1,
        "max": 5,
        "step": 1,
        "unit": "",
        "kind": "range"
      }
    ],
    "camera": [12, 8, 12]
  },
  {
    "id": "electrolysis",
    "title": "电解实验",
    "category": "virtual",
    "level": "basic",
    "description": "在本地三维装置中观察惰性电极电解水的气泡与收集。",
    "objectives": ["识别阴极和阳极产物", "联系反应计量关系解释2∶1"],
    "theory": "总反应2H₂O→2H₂＋O₂（通电），同温同压、忽略溶解与漏气时体积比约2∶1。溶液由离子导电。",
    "limits": "仅保留适当电解质辅助的水电解。移除上游错误复用相同气体模型的食盐水、硫酸铜选项；电流、气泡与毫升读数为示意，不是法拉第定量装置。纯水导电性很弱。",
    "topic": "主题三：水的组成；主题四：化学变化",
    "controls": [
      {
        "key": "voltage",
        "label": "voltage",
        "default": 6,
        "min": 1,
        "max": 12,
        "step": 0.5,
        "unit": "V",
        "kind": "range"
      },
      {
        "key": "step",
        "label": "step",
        "default": 5,
        "min": 1,
        "max": 5,
        "step": 1,
        "unit": "",
        "kind": "range"
      }
    ],
    "camera": [12, 10, 12]
  },
  {
    "id": "titration",
    "title": "酸碱滴定",
    "category": "virtual",
    "level": "extended",
    "description": "调节浓度和指示剂，逐滴观察颜色与pH曲线变化。",
    "objectives": ["识别理论当量点与指示剂终点的差别", "比较盐酸与乙酸滴定"],
    "theory": "固定酸液25mL，碱液NaOH；盐酸按25℃理想稀溶液酸碱平衡计算，乙酸使用质量/电荷平衡求解。",
    "limits": "忽略活度、温度变化和仪器误差；指示剂颜色近似，非标准定量分析软件。滴加后可暂停观察，单滴需先继续运行。",
    "topic": "主题五：酸、碱、盐",
