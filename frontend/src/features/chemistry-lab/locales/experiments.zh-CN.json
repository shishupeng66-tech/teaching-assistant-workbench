        "unit": "mol/L",
        "kind": "range"
      },
      {
        "key": "indicator",
        "label": "indicator",
        "default": "phenolphthalein",
        "unit": "",
        "options": [
          ["phenolphthalein", "phenolphthaleinLabel"],
