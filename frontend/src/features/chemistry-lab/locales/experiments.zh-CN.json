[
  {
    "id": "atomic-structure",
    "title": "原子结构",
    "category": "micro",
    "level": "basic",
    "description": "旋转原子模型，观察原子核与电子分层排布。",
    "objectives": [
      "由原子序数识别元素",
      "区分质子数、电子数与选用同位素质量数"
    ],
    "theory": "复用上游前20号元素数据与电子层动画；中性原子电子数等于质子数。",
    "limits": "固定选用同位素，中子数并非可独立调节；圆形轨道是玻尔式教学模型，不是电子真实轨迹。",
    "topic": "主题三：物质的组成与结构",
    "controls": [
      {
        "key": "atomicNumber",
        "label": "atomicNumber",
        "default": 6,
        "min": 1,
        "max": 20,
        "step": 1,
        "unit": "",
        "kind": "range"
      },
      {
        "key": "showElectronShells",
        "label": "showShells",
        "default": true,
        "unit": "",
        "kind": "check"
      }
    ],
    "camera": [8, 6, 8]
  },
  {
    "id": "chemical-bonding",
    "title": "化学键",
    "category": "micro",
    "level": "extended",
    "description": "观察电子转移、共用电子对和金属电子海的动态示意。",
    "objectives": ["比较三种化学键模型", "解释模型中的电子作用"],
    "theory": "保留上游离子键、共价键、金属键三个分步场景，以及水分子结构与NaCl晶格示意。",
    "limits": "电负性差不是键型绝对分界；原子接近不等于实际水生成机理，金属简化阵列不代表铁全部真实晶型。",
    "topic": "主题三：物质的组成与结构",
    "controls": [
      {
        "key": "bondType",
        "label": "bondType",
        "default": "ionic",
        "unit": "",
